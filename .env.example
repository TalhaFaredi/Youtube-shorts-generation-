# Copy to .env and fill in. .env is git-ignored; keys are never shown in the app, its logs or screenshots.

# OpenRouter: transcript tools, the Generate Video planner, images (GPT Image 2) and clips (HeyGen Video).
open_router_api=

# Optional overrides
# OPENROUTER_MODEL=qwen/qwen3.7-plus      # transcript tools
# PLANNER_MODEL=qwen/qwen3.7-plus         # Generate Video planner default
# IMAGE_MODEL=openai/gpt-image-2          # Generate Video image default ("GPT Image": closest match in the catalog)
# VIDEO_MODEL=heygen/heygen-video-1       # HeyGen Video, through OpenRouter
# VIDEO_BUDGET=5                          # default budget cap per video session, USD
# VIDEO_POLL_TIMEOUT=1800                 # seconds to wait for one clip
# HEYGEN_API_KEY=                         # not needed: HeyGen Video runs through OpenRouter
# APP_PORT=5000
# TTS_ENABLED=1                           # 0 = start without loading the voice models
# TTS_DEVICE=cuda:0
